# Configuration GuiPAM — copiez ce fichier en `.env` et ajustez.
# Toutes les variables sont préfixées GUIPAM_.

# --- Requis ---
# Clé de session : l'app refuse de démarrer sans une clé sérieuse (≥ 16 caractères).
# Générez-la avec :  openssl rand -hex 32
GUIPAM_SECRET_KEY=

# Premier compte manager, créé au premier démarrage si la base est vide.
# Aucun mot de passe par défaut : sans cette variable, le bootstrap refuse de démarrer.
GUIPAM_ADMIN_USERNAME=admin
GUIPAM_ADMIN_PASSWORD=

# --- Déploiement ---
# Chemin SQLite (dans le conteneur : laissez /data/guipam.db, persisté par le volume).
GUIPAM_DB_PATH=/data/guipam.db
GUIPAM_HOST=0.0.0.0
GUIPAM_PORT=8080

# Cookies `Secure` : true si GuiPAM est servi derrière TLS (reverse proxy HTTPS),
# false pour un accès HTTP direct (homelab).
GUIPAM_SECURE_COOKIES=false

# Durée de session en secondes (défaut : 14 jours).
GUIPAM_SESSION_MAX_AGE=1209600

# Langue par défaut de l'interface (fr ou en). Modifiable ensuite dans l'UI.
GUIPAM_DEFAULT_LOCALE=fr

# --- Suivi dynamique ---
# Période de réveil du scheduler (sélection des cibles dues).
GUIPAM_MONITOR_TICK_SECONDS=15
# Intervalle par défaut proposé pour une nouvelle cible.
GUIPAM_DEFAULT_CHECK_INTERVAL=60
# Nombre maximal de checks simultanés.
GUIPAM_MONITOR_CONCURRENCY=50
# Timeout de connexion TCP (secondes).
GUIPAM_TCP_TIMEOUT_SECONDS=3
# Ping ICMP (nécessite cap_add NET_RAW en conteneur). false = TCP uniquement.
GUIPAM_ENABLE_PING=true

# --- Seuils du code couleur santé (secondes depuis le dernier succès) ---
# vert → ambre
GUIPAM_HEALTH_WARN_SECONDS=120
# ambre → rouge
GUIPAM_HEALTH_RED_SECONDS=600
# rouge → rouge foncé (entrée probablement obsolète)
GUIPAM_HEALTH_DARK_RED_SECONDS=3600
# Période de rafraîchissement des pastilles dans l'UI.
GUIPAM_HEALTH_POLL_SECONDS=30
