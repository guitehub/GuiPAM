# Configuration GuiPAM — copiez ce fichier en `.env` et ajustez.
# Toutes les variables sont préfixées GUIPAM_.

# --- Requis ---
# Clé de session : l'app refuse de démarrer sans une clé sérieuse (≥ 16 caractères).
# Générez-la avec :  openssl rand -hex 32
GUIPAM_SECRET_KEY=

# Premier compte manager, créé au premier démarrage si la base est vide.
# Aucun mot de passe par défaut : sans cette variable, le bootstrap refuse de démarrer.
GUIPAM_ADMIN_USERNAME=admin
GUIPAM_ADMIN_PASSWORD=

# --- Déploiement ---
# Chemin SQLite (dans le conteneur : laissez /data/guipam.db, persisté par le volume).
GUIPAM_DB_PATH=/data/guipam.db
GUIPAM_HOST=0.0.0.0

# --- HTTPS et écouteurs ---
# HTTPS : accès principal, à publier.
GUIPAM_HTTPS_PORT=8443
# HTTP, selon GUIPAM_HTTP_MODE (remplace GUIPAM_PORT, encore acceptée mais dépréciée).
GUIPAM_HTTP_PORT=8080
# redirect : 308 vers l'HTTPS, seul /healthz y répond (défaut)
# proxy    : application complète en HTTP, pour un reverse proxy qui termine le TLS (ne pas publier ce port)
# off      : pas d'écouteur HTTP
GUIPAM_HTTP_MODE=redirect
# Port HTTPS vu des navigateurs s'il diffère de GUIPAM_HTTPS_PORT (ex. -p 443:8443 → 443) : cible des redirections.
# GUIPAM_PUBLIC_HTTPS_PORT=443
# Mode proxy : IP ou réseaux (CIDR) des reverse proxies dont on accepte X-Forwarded-For / X-Forwarded-Proto,
# séparés par des virgules. Vide : en-têtes ignorés, tous les clients ont l'IP du proxy.
# GUIPAM_TRUSTED_PROXIES=172.16.0.0/12

# auto : certificat fourni ci-dessous s'il est défini, sinon auto-signé persistant dans <dossier de la base>/tls.
# off  : HTTP seul (comportement ≤ 0.5), réservé au développement et aux tests.
GUIPAM_TLS=auto
# Noms DNS et IP par lesquels on joint GuiPAM, ajoutés au certificat auto-signé (séparés par des virgules).
# Le nom d'hôte d'un conteneur n'étant pas significatif, renseignez-les. Les modifier réémet le certificat (même clé).
GUIPAM_TLS_SANS=
# Certificat fourni (CA interne, ACME…) : chemins PEM dans le conteneur, les deux ensemble.
# GUIPAM_TLS_CERTFILE=/certs/fullchain.pem
# GUIPAM_TLS_KEYFILE=/certs/privkey.pem

# Cookies `Secure` (défaut : true). Ne mettre false qu'avec GUIPAM_TLS=off sans proxy HTTPS.
# GUIPAM_SECURE_COOKIES=true

# Session ordinaire (case « Rester connecté » décochée) : le cookie disparaît à la fermeture
# du navigateur, et la session expire après cette durée d'inactivité (défaut : 12 heures).
GUIPAM_SESSION_MAX_AGE=43200
# Case « Rester connecté » cochée : cookie persistant, renouvelé à chaque visite (défaut : 30 jours).
GUIPAM_REMEMBER_MAX_AGE=2592000

# Langue par défaut de l'interface (fr ou en). Modifiable ensuite dans l'UI.
GUIPAM_DEFAULT_LOCALE=fr

# --- Instantanés automatiques de la base (dans <dossier de la base>/backups) ---
# Nombre d'instantanés conservés ; 0 = désactivé.
GUIPAM_BACKUP_KEEP_PRE_MIGRATION=5
GUIPAM_BACKUP_KEEP_DAILY=7

# --- Suivi dynamique ---
# Période de réveil du scheduler (sélection des cibles dues).
GUIPAM_MONITOR_TICK_SECONDS=15
# Intervalle par défaut proposé pour une nouvelle cible (valeur initiale : voir ci-dessous).
GUIPAM_DEFAULT_CHECK_INTERVAL=60
# Nombre maximal de checks simultanés.
GUIPAM_MONITOR_CONCURRENCY=50
# Timeout de connexion TCP (secondes).
GUIPAM_TCP_TIMEOUT_SECONDS=3
# Ping ICMP (nécessite cap_add NET_RAW en conteneur). false = TCP uniquement.
GUIPAM_ENABLE_PING=true

# --- Seuils du code couleur santé ---
# Valeurs initiales : elles s'appliquent, comme GUIPAM_DEFAULT_CHECK_INTERVAL, tant qu'un manager ne les
# a pas redéfinies dans l'interface (Administration → Paramètres du réseau → Suivi) ou via l'API.
# Chaque cible est jugée à son propre rythme, quel que soit son intervalle.
# vert → ambre : dernier succès plus vieux que N fois l'intervalle de la cible.
GUIPAM_HEALTH_WARN_INTERVALS=2
# ambre → rouge : N échecs consécutifs.
GUIPAM_HEALTH_RED_FAILURES=10
# rouge → rouge foncé : secondes sans succès (entrée probablement obsolète). Défaut : 1 semaine.
GUIPAM_HEALTH_DARK_RED_SECONDS=604800
# Période de rafraîchissement des pastilles dans l'UI.
GUIPAM_HEALTH_POLL_SECONDS=30
